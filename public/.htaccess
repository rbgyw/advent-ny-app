# Missing static resources must never become the SPA HTML (or a custom HTML 200).
ErrorDocument 404 default
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteRule ^index\.html$ - [L]
  RewriteRule ^(?:assets|collections)(?:/|$) - [L]
  RewriteRule (?:^|/)[^/]+\.[^/]+$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>

<IfModule mod_headers.c>
  # Applies after internal history-mode rewrites as well as direct HTML requests.
  <FilesMatch "\.html$">
    Header always set Cache-Control "no-store, max-age=0"
  </FilesMatch>
  <FilesMatch "-[A-Za-z0-9_-]{8}\.(?:js|css|svg|png|jpe?g|webp|avif|gif|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.json$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
