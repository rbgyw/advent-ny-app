{
  "name": "gph-advent",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "test": "vitest run",
    "typecheck": "vue-tsc --noEmit -p tsconfig.app.json && npm run typecheck:gratitude && npm run typecheck:auth-email-policy && npm run typecheck:future-letters",
    "typecheck:gratitude": "tsc -p supabase/functions/send-gratitude/tsconfig.json",
    "typecheck:auth-email-policy": "tsc -p supabase/functions/auth-email-policy/tsconfig.json",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "audit:build": "node scripts/audit-build.mjs",
    "test:apache": "node scripts/test-apache.mjs",
    "video:catalog": "node scripts/generate-video-catalog.mjs",
    "test:browser": "playwright test",
    "metrics": "node scripts/bundle-metrics.mjs",
    "measure": "node scripts/measure-performance.ts",
    "test:e2e": "node scripts/test.mjs",
    "test:future-letters:postgres": "node scripts/test-future-letters-postgres.mjs",
    "typecheck:mail": "npm run typecheck:gratitude && npm run typecheck:future-letters",
    "typecheck:future-letters": "tsc -p supabase/functions/send-future-letters/tsconfig.json"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.2",
    "pinia": "^4.0.3",
    "vue": "^3.5.42",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.17",
    "@playwright/test": "^1.65.1",
    "@types/node": "^24.13.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/test-utils": "^2.6.0",
    "@vue/tsconfig": "^0.9.1",
    "aws4fetch": "1.0.20",
    "jsdom": "^31.0.1",
    "standardwebhooks": "1.0.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.1.0",
    "vue-tsc": "^3.3.11"
  }
}
