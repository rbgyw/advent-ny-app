# Edge Function settings (server only, independent of VITE_*).
# Only the exact string false allows valid email addresses of other domains.
ENFORCE_CORPORATE_EMAIL=true

# Generate independent HTTP hook signing secrets in Supabase Auth -> Hooks.
# Copy the Before User Created secret to SIGNUP and Custom Access Token to TOKEN.
# Never copy real secrets to Git or VITE_* variables.
AUTH_EMAIL_SIGNUP_HOOK_SECRET=
AUTH_EMAIL_TOKEN_HOOK_SECRET=
